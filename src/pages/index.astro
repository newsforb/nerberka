<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Barnaby Nerberka</title>

<style>

:root {
  --font-serif: "Times New Roman", Times, serif;
  --text: #111;
  --background: #fff;
  --width: 760px;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 20px;
  line-height: 1;
}

.container {
  width: min(calc(100% - 40px), var(--width));
  margin: auto;
}


/* Header */

header {
  padding: 20px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 28px;
}

nav {
  display: flex;
  gap: 15px;
}

nav a {
  color: inherit;
  text-decoration: none;
}


/* Hero */

.hero {
  padding: 90px 0;
}

h1 {
  font-size: clamp(50px, 8vw, 90px);
  font-weight: normal;
  line-height: 1;
  margin: 0 0 20px;
}

h2 {
  font-size: 42px;
  font-weight: normal;
}


/* Sections */

section {
  margin: 90px 0;
}


blockquote {
  border-left: 3px solid #111;
  padding-left: 25px;
  font-style: italic;
}


/* Footer */

footer {
  border-top: 1px solid #ddd;
  padding: 40px 0;
  margin-top: 20px;
  color: #555;
}


/* Mobile */

@media(max-width:600px){

header {
  display:block;
}

nav {
  margin-top:20px;
}

body {
  font-size:18px;
}

}

</style>

</head>

<body>


<header class="container">

<div class="logo">
Barnaby Nerberka
</div>




</header>
<main class="container">
<section class="hero">
<h2>
Current & Foreign Affairs<br>
Correspondent, Producer & Editor
</h2>

<p>
National Union of Journalists<br>
International Federation of Journalists<br>
Foreign Press Association of London
</p>
<p>
<p>
<br>
<a href="mailto:b@nerberka.com">b@nerberka.com</a>
</body>
</html>
