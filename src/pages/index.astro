<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Barnaby Nerberka</title>

<style>

:root {
    --font-serif: "Times New Roman", Times, serif;
    --text: #111;
    --background: #fff;
    --muted: #555;
    --border: #ddd;
    --width: 760px;
}


* {
    box-sizing: border-box;
}


body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.35;
}


.container {
    width: min(calc(100% - 40px), var(--width));
    margin: 0 auto;
}


/* Header */

header {
    padding: 30px 0;
    border-bottom: 1px solid var(--border);
}


.logo {
    font-size: 32px;
}


/* Main */

.hero {
    padding: 70px 0 50px;
}


h1,
h2 {
    font-weight: normal;
    margin: 0;
}


h1 {
    font-size: clamp(50px, 8vw, 90px);
    line-height: 1;
}


h2 {
    font-size: 42px;
    line-height: 1.15;
}


p {
    margin: 25px 0;
}


a {
    color: inherit;
}


/* Sections */

section {
    margin: 60px 0;
}


blockquote {
    border-left: 3px solid var(--text);
    padding-left: 25px;
    margin-left: 0;
    font-style: italic;
}


/* Footer */

footer {
    border-top: 1px solid var(--border);
    padding: 30px 0;
    margin-top: 50px;
    color: var(--muted);
}


/* Mobile */

@media (max-width: 600px) {

    body {
        font-size: 18px;
    }

    .hero {
        padding: 50px 0 30px;
    }

    h2 {
        font-size: 32px;
    }

}

</style>

</head>


<body>


<header class="container">

    <div class="logo">
        Barnaby Nerberka
    </div>

</header>



<main class="container">

    <section class="hero">

        <h2>
            Correspondent, Producer &amp; Editor<br>
            Current &amp; Foreign Affairs
        </h2>


        <p>
            National Union of Journalists<br>
            International Federation of Journalists<br>
            Foreign Press Association
        </p>


        <p>
            <a href="mailto:b@nerberka.com">
                b@nerberka.com
            </a>
        </p>

    </section>

</main>



<footer class="container">

    &copy; Barnaby Nerberka

</footer>


</body>

</html>
